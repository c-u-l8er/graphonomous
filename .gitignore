# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
graphonomous-*.tar

# Release dist assets (uploaded to GitHub Releases, not committed)
/dist/

# Local SQLite artifacts under priv/
priv/*.db
priv/*.db-*
priv/*.db.*

# LongMemEval benchmark data (downloaded from HuggingFace, ~280MB)
priv/longmemeval/*.json

# Graphonomous v2 (G0 lane) scratch output of the Python canon twin
/v2/test/.twin-out/

# G0.5 UI: ui/data is a BUILD PRODUCT of tools/g05_build.mjs over the shipped projections (36 MB, four worlds).
# It is regenerated by `node tools/g05_build.mjs --out ui/data` and test/g05.test.mjs rebuilds it into a temp dir
# and asserts the committed page would render exactly Graph.explain()'s output — so the bytes need not be tracked.
v2/ui/data/
