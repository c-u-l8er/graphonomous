{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://graphonomous.com/g0/schemas/rules.schema.json",
 "title": "G0 rule set as data (spec §13, D-022 names)",
 "x-g0-witness": [],
 "type": "object",
 "required": [
  "ruleset",
  "version",
  "facts",
  "rules"
 ],
 "additionalProperties": false,
 "properties": {
  "ruleset": {
   "const": "G0-RULESET-v1"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "comment": {
   "type": "string"
  },
  "facts": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "arity",
     "doc"
    ],
    "additionalProperties": false,
    "properties": {
     "arity": {
      "type": "integer",
      "minimum": 1
     },
     "doc": {
      "type": "string"
     }
    }
   }
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "stratum",
     "head",
     "body"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "stratum": {
      "type": "integer",
      "minimum": 0
     },
     "doc": {
      "type": "string"
     },
     "reports": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
     },
     "head": {
      "type": "object",
      "required": [
       "rel",
       "args"
      ],
      "additionalProperties": false,
      "properties": {
       "rel": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "args": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     },
     "body": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "rel",
        "args"
       ],
       "additionalProperties": false,
       "properties": {
        "rel": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "args": {
         "type": "array",
         "items": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "boolean"
           },
           {
            "type": "null"
           },
           {
            "$ref": "#/$defs/safe_int"
           }
          ]
         }
        },
        "neg": {
         "type": "boolean"
        }
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "lid": {
   "type": "string",
   "pattern": "^[a-z]+:[a-z0-9][a-z0-9.-]*:[A-Za-z0-9._/@+~#%:-]+$",
   "minLength": 5,
   "maxLength": 1024
  },
  "hash": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "hex64": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "git_oid": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "pinned_identity": {
   "anyOf": [
    {
     "$ref": "#/$defs/git_oid"
    },
    {
     "$ref": "#/$defs/hash"
    }
   ]
  },
  "decimal_string": {
   "type": "object",
   "properties": {
    "decimal_string": {
     "type": "string",
     "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
    }
   },
   "required": [
    "decimal_string"
   ],
   "additionalProperties": false
  },
  "safe_int": {
   "type": "integer",
   "minimum": -9007199254740991,
   "maximum": 9007199254740991
  },
  "basis": {
   "enum": [
    "observed",
    "derived",
    "proposed"
   ]
  },
  "precision": {
   "enum": [
    "pointer",
    "heading",
    "line",
    "symbol",
    "file"
   ]
  },
  "snapshot_id": {
   "type": "string",
   "pattern": "^snapshot:g0:[a-z0-9.-]+$"
  },
  "node_kind": {
   "enum": [
    "OBLIGATION",
    "ENFORCEMENT_PROPERTY",
    "CLAIM",
    "LAW",
    "MECHANISM",
    "DEFINITION",
    "REPRESENTATION",
    "PROFILE",
    "ASSUMPTION",
    "WITNESS",
    "FALSIFIER",
    "FINDING",
    "EXPERIMENT",
    "RECEIPT",
    "ARTIFACT",
    "ADJUDICATION",
    "EVIDENCE_STATE_TRANSITION",
    "ROUND",
    "CELL",
    "REGISTRY",
    "SOURCE_LOCATION",
    "FAULT",
    "PROPOSAL"
   ]
  },
  "relation_kind": {
   "enum": [
    "STATES",
    "IMPLEMENTS",
    "DERIVES_FROM",
    "REDUCES_TO",
    "REFINES",
    "SPLIT_FROM",
    "SUPERSEDES",
    "RETRACTS",
    "REQUIRES",
    "WITNESSES",
    "SUPPORTS",
    "FALSIFIES",
    "ATTACKS",
    "TESTED_UNDER",
    "SCOPED_BY",
    "ASSUMES",
    "CLOSES",
    "OPENS",
    "PRODUCED_BY",
    "ADJUDICATED_BY",
    "LOCATED_IN",
    "MEMBER_OF",
    "BINDS",
    "CITES",
    "INDEPENDENT_OF",
    "CONFLICTS_WITH",
    "EQUIVALENT_TO",
    "DEFINES",
    "REPRESENTS",
    "CROSS_CUTS",
    "STATE_TRANSITION_OF"
   ]
  },
  "digest_set": {
   "type": "object",
   "properties": {
    "sha256": {
     "$ref": "#/$defs/hex64"
    },
    "gitCommit": {
     "$ref": "#/$defs/git_oid"
    },
    "gitTree": {
     "$ref": "#/$defs/git_oid"
    },
    "gitBlob": {
     "$ref": "#/$defs/git_oid"
    },
    "dirHash1": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false,
   "minProperties": 1
  },
  "resource_descriptor": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "uri": {
     "type": "string",
     "minLength": 1
    },
    "digest": {
     "$ref": "#/$defs/digest_set"
    },
    "media_type": {
     "type": "string"
    }
   },
   "required": [
    "uri",
    "digest"
   ],
   "additionalProperties": false
  },
  "unknown": {
   "type": "object",
   "properties": {
    "unknown": {
     "enum": [
      "not-stated",
      "not-executed",
      "undecidable-from-data",
      "source-dangling",
      "masked"
     ]
    }
   },
   "required": [
    "unknown"
   ],
   "additionalProperties": false
  },
  "evidence_state": {
   "type": "object",
   "properties": {
    "token": {
     "type": "string",
     "minLength": 1
    },
    "vocabulary": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "text": {
     "type": "string"
    }
   },
   "required": [
    "token",
    "vocabulary"
   ],
   "additionalProperties": false
  },
  "attr_value": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "boolean"
    },
    {
     "$ref": "#/$defs/safe_int"
    },
    {
     "type": "string"
    },
    {
     "$ref": "#/$defs/decimal_string"
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/attr_value"
     }
    },
    {
     "type": "object",
     "propertyNames": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
     },
     "additionalProperties": {
      "$ref": "#/$defs/attr_value"
     }
    }
   ]
  },
  "attrs": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "additionalProperties": {
    "$ref": "#/$defs/attr_value"
   }
  }
 }
}
